{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "import/extensions": "off",
    "no-underscore-dangle": "off",
    "class-methods-use-this": "off",
    "max-len": ["error", { "code": 120, "ignoreComments": true }]
  }
}

